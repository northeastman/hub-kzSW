# ============================================================
#  AI 每日新闻自动推送 - 环境变量配置示例
#
#  使用方法：
#    1. 复制本文件为 .env （同目录下）
#    2. 填入你自己的 DEEPSEEK_API_KEY
#    3. 其余项有默认值，可按需修改
#
#  注意：.env 含敏感信息，切勿提交到 git
# ============================================================

# 【必填】DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 【可选】API 地址与模型（默认即 DeepSeek 官方）
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# 【可选】RSS 源，多个用 | 分隔（留空则用脚本默认值）
# 默认源（脚本内置，无需配置）：量子位/雷峰网/InfoQ（核心3源，权重3）+ 掘金/IT之家（补充2源，权重1）
# 已剔除拉低均分的源：博客园(个人博客)/钛媒体(偏商业)/36氪(偏创投)
# 如需自定义，多个用 | 分隔（自定义源默认权重1），取消下面注释即可
# RSS_FEEDS=https://your-feed-1|https://your-feed-2

# 【可选】抓取多少小时内的新闻（默认 48 小时）
FRESH_HOURS=48

# 【可选】跨天去重时回看多少天的已推送标题
DEDUP_DAYS=7
